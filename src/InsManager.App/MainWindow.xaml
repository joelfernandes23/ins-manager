<Window x:Class="InsManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="727 INS Manager" Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="#0B1014" Foreground="#E8EEF2" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Background" Value="#D98B34" />
            <Setter Property="Foreground" Value="#101316" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#121A20" />
            <Setter Property="BorderBrush" Value="#25313A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="727 INS MANAGER" />
                <TextBlock Margin="0,6,0,0" Foreground="#8FA0AA" Text="FlightSim Studio 727 · CIVA route automation" />
            </StackPanel>
            <Border Grid.Column="1" Padding="14,8" Background="#172127" CornerRadius="18">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="#67737A" />
                    <TextBlock Foreground="#B7C2C8" Text="{Binding ConnectionStatus}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="1.35*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#8FA0AA" Text="ROUTE SOURCE" />
                        <TextBlock Margin="0,7,0,16" FontSize="20" FontWeight="SemiBold" Text="SimBrief" />
                        <TextBlock Foreground="#8FA0AA" Text="Pilot ID" />
                        <TextBox Margin="0,7,0,16" Padding="11" Background="#0B1014" BorderBrush="#35434C" Foreground="White" Text="Not configured" />
                        <Button HorizontalAlignment="Left" Command="{Binding LoadRouteCommand}" Content="Load sample flight" />
                        <TextBlock Margin="0,12,0,0" Foreground="#8FA0AA" Text="{Binding RouteStatus}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,20,0,0" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="#8FA0AA" Text="AUTOMATION" />
                        <CheckBox Margin="0,16,0,0" Foreground="#E8EEF2" Content="Auto-manage waypoint slots" IsChecked="{Binding AutoManageWaypoints}" />
                        <CheckBox Margin="0,13,0,0" Foreground="#E8EEF2" Content="Correct INS drift" IsChecked="{Binding CorrectDrift}" />
                        <TextBlock Margin="0,18,0,5" Foreground="#8FA0AA" Text="Correction interval" />
                        <ComboBox Padding="8" SelectedIndex="1">
                            <ComboBoxItem Content="30 seconds" /><ComboBoxItem Content="60 seconds" /><ComboBoxItem Content="5 minutes" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="22" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="22" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="12" Foreground="#8FA0AA" Text="INS STATUS" />
                    <UniformGrid Grid.Row="2" Columns="3">
                        <StackPanel><TextBlock Foreground="#8FA0AA" Text="FROM" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="31" Foreground="#F2A84B" Text="{Binding FromSlot}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#8FA0AA" Text="TO" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="31" Foreground="#F2A84B" Text="{Binding ToSlot}" /></StackPanel>
                        <StackPanel><TextBlock Foreground="#8FA0AA" Text="ACCURACY" /><TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="31" Foreground="#F2A84B" Text="{Binding Accuracy}" /></StackPanel>
                    </UniformGrid>
                    <StackPanel Grid.Row="4">
                        <TextBlock Margin="0,0,0,12" FontSize="17" FontWeight="SemiBold" Text="Waypoint buffer" />
                        <Border Padding="16" Background="#0B1014" BorderBrush="#25313A" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                <TextBlock Foreground="#75848D" Text="SLOT" /><TextBlock Grid.Column="1" Foreground="#75848D" Text="WAYPOINT" /><TextBlock Grid.Column="2" Foreground="#75848D" Text="STATE" />
                            </Grid>
                        </Border>
                        <ListView Margin="0,8,0,0" ItemsSource="{Binding Slots}" Background="Transparent" BorderThickness="0" Foreground="#D7E0E5">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="Consolas" Text="{Binding Number}" />
                                        <TextBlock Grid.Column="1" FontFamily="Consolas" Text="{Binding Waypoint.Identifier, TargetNullValue=—}" />
                                        <TextBlock Grid.Column="2" Foreground="#8FA0AA" Text="{Binding State}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#67737A" Text="Mock mode · no simulator commands are sent" />
            <Button Grid.Column="1" Command="{Binding ConnectCommand}" Content="Connect mock simulator" />
        </Grid>
    </Grid>
</Window>
